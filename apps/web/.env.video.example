# Optional video beta configuration. Keep secret values in deployment/worker secret settings.
# Apply the video migration to a verified database before starting the worker.
VIDEO_BETA_EMAILS=
VIDEO_HYPIT_RUNTIME=.video-runtime/account01.env.json
# Set RUNNINGHUB_API_KEY_01 in the worker secret environment only; no 02 fallback exists.
RUNNINGHUB_API_KEY_01=
# Conservative per-4/5-second-segment estimate, in RH coins. Blank disables paid video submissions.
VIDEO_H3_SEGMENT_QUOTE_COINS=
VIDEO_WORK_ROOT=
VIDEO_FFMPEG_PATH=
VIDEO_FFPROBE_PATH=
# Production: use a dedicated PRIVATE R2 bucket plus existing R2 S3 credentials.
VIDEO_R2_BUCKET=
# Local/self-hosted alternative: shared absolute directory accessible by web + worker.
VIDEO_STORAGE_DIR=
