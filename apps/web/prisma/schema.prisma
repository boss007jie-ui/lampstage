// Prisma schema for 灯境 AI MVP
// 与 PRD v3 第 9 节数据结构对齐

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum BackgroundType {
  transparent
  white
  simple
  complex
  unknown
}

enum PlatformStyle {
  domestic_ecommerce
  brand_site
}

enum AspectRatio {
  ratio_1_1
  ratio_4_5
  ratio_16_9
}

enum SceneKind {
  recommended
  template
  custom
  profile
}

enum JobStatus {
  created
  uploading
  generating
  completed
  failed
}

enum CreditTxType {
  grant
  consume
  refund
  manual_adjustment
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String?  @unique
  phone          String?  @unique
  password_hash  String?
  email_verified DateTime?
  credit_balance Int      @default(0)
  role           Role     @default(USER)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  uploaded_assets UploadedAsset[]
  jobs            GenerationJob[]
  credit_txs      CreditTransaction[]
  contact_leads   ContactLead[]
  sessions        Session[]
  recharge_orders RechargeOrder[]
  video_assets    VideoAsset[]
  video_jobs      VideoJob[]
  api_keys        ApiKey[]
}

/// API credentials for WorkBuddy and other server-side integrations.
/// Only the SHA-256 digest is stored; the full token is returned once on creation.
model ApiKey {
  id           String    @id @default(cuid())
  user_id      String
  name         String    @default("WorkBuddy")
  key_prefix   String
  key_hash     String    @unique
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  revoked_at   DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([user_id, revoked_at])
}

model Session {
  id         String   @id @default(cuid())
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model UploadedAsset {
  id              String         @id @default(cuid())
  user_id         String
  image_url       String
  file_type       String
  width           Int
  height          Int
  background_type BackgroundType @default(unknown)
  detected_lamp_type String?
  quality_warning String?
  /// 灯具档案 V1: AI 推断 + 用户确认
  size_class       String?
  size_hint_cm     Int?
  shade_diameter_cm      Int?
  fixture_height_cm      Int?
  cord_or_chain_drop_cm  Int?
  scale_band             String?
  color_temp       String?
  target_audience  String?
  material_keywords String?   // comma-separated, e.g. "rattan,flat disc,black chain"
  space_fit        String?   // comma-separated SPACE_POOL keys, ranked, e.g. "dining_room,living_room,entryway"
  ai_inferred_at   DateTime?
  /// 预生成的图生图提示词计划（PromptPlan JSON）。由 /api/generation/plan 在点生成时按当前产品卡现写并存入，
  /// 生成接口直接读取，避免 planner 同步跑挤占 60s 预算。改产品卡会重新生成，不存在过期。
  planned_shots    Json?
  planned_at       DateTime?
  created_at      DateTime       @default(now())

  user User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  jobs GenerationJob[]

  @@index([user_id, created_at])
}

model SceneSeed {
  id              String   @id @default(cuid())
  scene_type      String
  target_audience String
  time_of_day     String
  image_url       String
  quality_score   Int      @default(0)
  usage_count     Int      @default(0)
  source          String   @default("seed")
  is_qualified    Boolean  @default(false)
  created_at      DateTime @default(now())
  last_used_at    DateTime?

  @@index([scene_type, target_audience, time_of_day, quality_score])
  @@index([is_qualified, usage_count])
}

model Template {
  id                String   @id @default(cuid())
  name              String
  category          String
  lamp_type         String
  scene_space       String
  preview_image_url String
  prompt_template   String
  is_active         Boolean  @default(true)
  sort_order        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  jobs GenerationJob[]

  @@index([is_active, sort_order])
}

model GenerationJob {
  id                String        @id @default(cuid())
  user_id           String
  uploaded_asset_id String
  template_id       String?
  scene_kind        SceneKind     @default(template)
  prompt_text       String?
  platform_style    PlatformStyle
  aspect_ratio      AspectRatio
  credit_cost       Int           @default(4)
  status            JobStatus     @default(created)
  failure_reason    String?
  provider_job_id   String?
  stage_hint        String?
  metadata          Json?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  uploaded_asset UploadedAsset @relation(fields: [uploaded_asset_id], references: [id])
  template       Template?     @relation(fields: [template_id], references: [id])

  outputs    OutputImage[]
  credit_txs CreditTransaction[]

  @@index([user_id, created_at])
  @@index([status, created_at])
}

model OutputImage {
  id            String    @id @default(cuid())
  job_id        String
  image_url     String
  thumbnail_url String?
  quality_score Float?
  is_downloaded Boolean   @default(false)
  downloaded_at DateTime?
  created_at    DateTime  @default(now())

  job GenerationJob @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([job_id])
}

model CreditTransaction {
  id             String       @id @default(cuid())
  user_id        String
  type           CreditTxType
  amount         Int
  related_job_id String?
  note           String?
  created_at     DateTime     @default(now())

  user User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  job  GenerationJob? @relation(fields: [related_job_id], references: [id])

  @@index([user_id, created_at])
}

model ContactLead {
  id           String   @id @default(cuid())
  user_id      String?
  source       String
  contact_type String
  name         String?
  phone        String?
  wechat       String?
  email        String?
  message      String?
  created_at   DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([source, created_at])
  @@index([contact_type, created_at])
}

model VerificationCode {
  id         String   @id @default(cuid())
  identifier String
  code_hash  String
  type       String
  expires_at DateTime
  consumed   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([identifier, type, created_at])
}

enum RechargeStatus {
  pending
  paid
  failed
  expired
}

model RechargeOrder {
  id              String         @id @default(cuid())
  /// 我们生成的订单号，发给虎皮椒做 trade_order_id
  order_no        String         @unique
  user_id         String
  /// 充值包标识：basic / business / factory
  pack            String
  /// 实际付款金额（元，保留 2 位小数）
  amount_yuan     Decimal        @db.Decimal(10, 2)
  /// 充值后增加的额度数（张）
  credits         Int
  /// 渠道：wechat / alipay
  channel         String?
  status          RechargeStatus @default(pending)
  /// 虎皮椒侧返回的支付链接
  pay_url         String?
  /// 虎皮椒侧的交易号（回调时填）
  xunhupay_trade_no String?
  /// 回调原始 payload，便于排查
  callback_raw    Json?
  paid_at         DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([status, created_at])
}


/// 外部 AI 工具调用日志（识图 / 提示词规划 / 生图）。便于后台排查成功率、耗时、失败原因。
model ToolCallLog {
  id          String   @id @default(cuid())
  /// 调用类型：lamp_profile / prompt_planner / nano-banana / gpt-image-2
  tool        String
  /// 实际使用的模型名（如 gpt-5.5 / gemini-3.1-flash-image）
  model       String?
  /// 关联的生成任务（生图时有；识图/规划时可能为空）
  job_id      String?
  /// 关联的上传素材（识图时有）
  asset_id    String?
  /// ok / failed
  status      String
  /// 外部 API 的 HTTP 状态码
  http_status Int?
  /// 调用耗时（毫秒）
  duration_ms Int?
  /// 失败原因（截断保存）
  error       String?
  /// planner 成功时存的完整 PromptPlan JSON（用于后台查阅），失败时为 null
  result_json String?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([tool, created_at])
  @@index([status, created_at])
}

/// Private video uploads. Objects are never served through the public image bucket URL.
model VideoAsset {
  id          String   @id @default(cuid())
  user_id     String
  storage_key String   @unique
  mime        String
  size_bytes  Int
  status      String   @default("pending")
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  jobs        VideoJob[]
  @@index([user_id, created_at])
}

/// Durable queue: updateMany compare-and-swap claims + lease heartbeats.
model VideoJob {
  id               String    @id @default(cuid())
  user_id          String
  source_asset_id  String
  product_asset_id String
  title            String
  instructions     String    @default("")
  preserve_audio   Boolean   @default(true)
  status           String    @default("draft")
  phase            String    @default("prepare")
  stage            String    @default("等待准备参考图")
  data             Json
  error            String?
  lease_owner      String?
  lease_until      DateTime?
  revision         Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_asset     VideoAsset @relation(fields: [source_asset_id], references: [id])
  @@index([user_id, created_at])
  @@index([status, created_at])
}

model VideoWorker {
  id           String   @id
  heartbeat_at DateTime @default(now())
  image_ready  Boolean  @default(false)
  video_ready  Boolean  @default(false)
  detail       String?
}
