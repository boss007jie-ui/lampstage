# Copy to .env.prod on the CVM and chmod 600. Never commit the filled file.
# infra/tencent/.env.prod 与 infra/tencent/runtime/ 已在 .gitignore 中忽略。
LAMPSTAGE_DOMAIN=lampstage.com

# TencentDB for PostgreSQL。两个 URL 都是必需的：prisma/schema.prisma 里写了
# directUrl = env("DIRECT_URL")，缺 DIRECT_URL 会让 Prisma Client 直接抛错。
# 保留 ?schema=public 后缀。
DATABASE_URL=postgresql://lampstage:CHANGE_ME@PRIVATE_POSTGRES_HOST:5432/lampstage?schema=public
DIRECT_URL=postgresql://lampstage:CHANGE_ME@PRIVATE_POSTGRES_HOST:5432/lampstage?schema=public

# Tencent COS S3-compatible endpoint. Use a dedicated public image bucket and
# a separate private video bucket. New COS buckets require virtual-hosted style.
R2_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
R2_REGION=ap-guangzhou
R2_FORCE_PATH_STYLE=false
R2_BUCKET=lampstage-prod-assets-1257701892
R2_PUBLIC_BASE=https://lampstage-prod-assets-1257701892.cos.ap-guangzhou.myqcloud.com
R2_ACCESS_KEY_ID=CAM_OR_TEMPORARY_ID
R2_SECRET_ACCESS_KEY=CAM_OR_TEMPORARY_SECRET
VIDEO_R2_BUCKET=lampstage-prod-videos-1257701892
VIDEO_R2_REGION=ap-guangzhou
VIDEO_R2_FORCE_PATH_STYLE=false

# Server-side provider credentials. Inject through Tencent SSM/CAM at runtime.
OPENLUX_API_KEY=
RUNNINGHUB_API_KEY_01=
VIDEO_BETA_EMAILS=
VIDEO_H3_SEGMENT_QUOTE_COINS=
VIDEO_HYPIT_RUNTIME=/srv/lampstage/runtime/account01.runtime.json
VIDEO_HYPIT_PACKAGE_ROOT=/app/apps/web/vendor/hypit
VIDEO_WORK_ROOT=/srv/lampstage/video-work
VIDEO_FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_FFPROBE_PATH=/usr/bin/ffprobe

# 注册/登录验证码邮件。RESEND_API_KEY 为空时服务端只写日志、不真正发信。
RESEND_API_KEY=
RESEND_FROM=Lampstage <hello@lampstage.com>

# 生成绝对链接的对外入口（支付回调、邮件里的链接）。
PUBLIC_BASE_URL=https://lampstage.com

# 管理后台白名单。视频内测白名单读取 VIDEO_BETA_EMAILS + ADMIN_EMAILS。
ADMIN_EMAILS=

# GET /api/cron/weekly-scenes 的 Bearer 密钥。
CRON_SECRET=

# WorkBuddy 从 lampstage.com 之外调用 /api/mcp。同源永远放行，其他来源必须
# 在这里显式列出，否则请求被 403 origin_not_allowed 拒绝。
# 逗号分隔，写完整 origin（协议 + 主机）。
# 兜底把自家域名也列上：反向代理后的同源判断依赖 Host 透传，列上可以避免
# 代理配置差异导致自己的页面反而被 403。
MCP_ALLOWED_ORIGINS=https://lampstage.com,https://www.lampstage.com,https://www.workbuddy.cn,https://workbuddy.cn,https://staging.workbuddy.cn

# 内容服务凭据。以下 5 个调用点全部走 DeepSeek，默认模型 deepseek-flash
# （统一配置见 apps/web/lib/deepseek.ts）：
#   lamp-detect / lamp-profile / prompt-planner / scene-quality / suggest-scenes
# 2026-10-13 起 yunwu 已完全剔除，YUNWU_API_KEY 不再被任何运行时代码读取，
# 因此这里不再保留该项。注意 DeepSeek 对未知 model id 会静默回落，
# 别把 *_MODEL 覆盖成别的厂商模型名。
DEEPSEEK_API_KEY=
# 可选。留空即用 https://api.deepseek.com；仅在需要换网关时填。
DEEPSEEK_BASE_URL=

# 充值（虎皮椒 / Xunhupay）。
XUNHUPAY_APPID=
XUNHUPAY_APPSECRET=

# 可选：不想用 COS 视频桶时，用本地私有目录保存视频（仅 Worker 主机）。
# 生产环境下 R2 配置与 VIDEO_STORAGE_DIR 二者必须有一个，否则整个视频功能
# 会报 storage_ready=false。
# VIDEO_STORAGE_DIR=/srv/lampstage/video-private
